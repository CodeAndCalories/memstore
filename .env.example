PORT=3000

# Supabase — Postgres database with the pgvector extension enabled.
# The service-role key is used server-side only; it bypasses RLS.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# OpenAI — generates the 1536-dimension embeddings used for semantic recall
OPENAI_API_KEY=sk-...

# Resend — transactional email (welcome emails, API key delivery)
RESEND_API_KEY=re_...

# Admin dashboard token (used by GET /v1/admin/agents)
ADMIN_TOKEN=your-secret-admin-token

# Stripe — subscription billing. The webhook secret signs incoming events;
# the two price IDs map a completed checkout to a plan and its ops quota.
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_STARTER_PRICE_ID=price_...
STRIPE_PRO_PRICE_ID=price_...
